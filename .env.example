# Copy this file to .env and fill in your local secrets.
# Never commit the real .env file.

SILICONFLOW_API_KEY=
TELEGRAM_BOT_TOKEN=
# Optional. Defaults to the folder containing the YueYue Python files.
YUEYUE_ROOT_DIR=
YUEYUE_TURN_DEBOUNCE_SECONDS=5.5
# Optional model routing. YUEYUE_CHAT_MODEL drives owner-facing voice (chat turns, owner-voice
# task replies, fast greetings/sticker lines, presence check-ins); planning/tool execution stays
# on YUEYUE_TASK_MODEL/YUEYUE_STRONG_MODEL. Leave blank to use the strong default for every route.
YUEYUE_CHAT_MODEL=Pro/MiniMaxAI/MiniMax-M2.5
YUEYUE_STRONG_MODEL=deepseek-ai/DeepSeek-V4-Pro
# Task/planning model. Blank = fall back to STRONG_MODEL (DeepSeek-V4-Pro). A 2026-07-15 gap-battery
# A/B found cheaper models regress task quality hard (V4-Pro 4-5/6 vs DeepSeek-V3.2 1/6, MiniMax-M2.5
# 2/6), so V4-Pro stays for tasks. If task volume ever makes cost hurt, lower reasoning effort first.
YUEYUE_TASK_MODEL=
# Reasoning depth for task execution/planning/verification only (never chat). SiliconFlow
# DeepSeek honors OpenAI-standard low/medium/high; "high" is the real ceiling. Default high.
YUEYUE_TASK_REASONING_EFFORT=high
VISION_MODEL=
# Optional reply-pacing tuning (CHAT/SOCIAL turns only; skips task turns and urgent/low-mood).
# YUEYUE_REPLY_PACING_PROBABILITY=0.15
# Optional single-instance lock port for `main.py --telegram` (default 48620).
# YUEYUE_SINGLETON_PORT=48620
